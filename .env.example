# Server Configuration
PORT=3000
API_KEY=SECRET_BEARER_TOKEN
JWT_SECRET=SUPER_SECRET_JWT_KEY_DISCORD_MCHAT_123

# Database PostgreSQL Connection
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/discordmchat

# Discord OAuth2 Application Credentials (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Discord User ID or Username (Automatically assigned as Administrator on login)
INITIAL_ADMIN_DISCORD_ID=your_discord_user_id

# Discord Webhook URL (Forward chat & server events from Minecraft to Discord)
DISCORD_WEBHOOK_URL=

# Discord Bot Token (For 2-way real-time chat Discord -> Minecraft)
# Obtain from Discord Developer Portal -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Discord Channel ID monitored by the Bot
DISCORD_CHANNEL_ID=

# Discord Server Invite URL (Join Our Channel)
DISCORD_INVITE_URL=

FRONTEND_URL=http://localhost:3000
